# Supabase server-side persistence (required in production)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Etsy Open API application keystring:shared_secret; server-only, never NEXT_PUBLIC_.
ETSY_API_KEY=

# Canonical public origin, without a trailing slash (for SEO metadata and sitemap)
NEXT_PUBLIC_SITE_URL=

# Single administrator credentials. Never prefix these with NEXT_PUBLIC_.
# Use a unique password (at least 16 characters) and a separate random secret
# of at least 32 characters, for example: openssl rand -base64 48
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional public support address shown on /contact
NEXT_PUBLIC_CONTACT_EMAIL=
